{
  "expo": {
    "name": "CorujaDocs",
    "slug": "corujadocs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1B1F3B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corujadocs.app"
    },
    "android": {
      "package": "com.corujadocs.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B1F3B"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
